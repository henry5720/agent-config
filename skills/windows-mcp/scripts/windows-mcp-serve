#!/usr/bin/env bash
# 給別台 agent 用的 HTTP server：換新 key → 在 0.0.0.0:8000 起 server → key 複製到 Windows 剪貼簿。
# 開到 tailnet 外交給 expose-port（Funnel 不能改寫 Host，server 才綁 0.0.0.0，見 windows-mcp 的 reference.md）。
# 在桌機 WSL 跑：要靠 powershell.exe 操作 Windows 那邊。key 不印出來。
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/windows-mcp-common.sh"

listening() { pwsh "(Get-NetTCPConnection -LocalPort $PORT -State Listen -ErrorAction SilentlyContinue | Measure-Object).Count"; }

exe_win=$(pwsh '"$env:USERPROFILE\.local\bin\windows-mcp.exe"')
[ -f "$(wslpath "$exe_win")" ] || { echo "沒裝 windows-mcp，照 SKILL.md「第一次安裝」裝好再跑" >&2; exit 1; }
[ "$(listening)" = 0 ] || { echo "$PORT 已經有程式在聽，先跑 windows-mcp-stop" >&2; exit 1; }

# 1. 防火牆要擋住區網直連 8000：server 綁 0.0.0.0，只靠 key 擋
allow=$(pwsh "Get-NetFirewallRule -Direction Inbound -Action Allow -Enabled True | Where-Object { (\$_ | Get-NetFirewallApplicationFilter).Program -match 'windows-mcp|\\\\uv\\\\' } | ForEach-Object DisplayName")
[ -z "$allow" ] || { echo "防火牆有放行 windows-mcp 的 inbound 規則，區網可直連 $PORT：$allow" >&2; exit 1; }

# 2. 換新 key
echo "換新 key…"
pwsh "& '$exe_win' auth --transport streamable-http --host 0.0.0.0 --port $PORT --force *> \$null"

# 3. 起 server，等它開始聽
echo "啟動 server（最小化視窗，log 在那個視窗裡）…"
pwsh "Start-Process -WindowStyle Minimized -FilePath '$exe_win' -ArgumentList 'serve','--host','0.0.0.0'"
for _ in $(seq 1 30); do [ "$(listening)" = 0 ] || break; sleep 1; done
[ "$(listening)" != 0 ] || { echo "server 30 秒內沒在 $PORT 起來。從 ssh 跑的話沒有互動桌面，server 會直接結束：要在那台桌面開的終端機跑（見 reference.md）" >&2; exit 1; }

# 4. key 複製到剪貼簿，給使用者交給對方 agent。printf 是 bash 內建，key 不會出現在 ps 看得到的參數裡
key=$(auth_key) || { echo "config.toml 裡沒有 auth_key：換 key 沒成功" >&2; exit 1; }
printf %s "$key" | clip.exe
echo "server 在 0.0.0.0:$PORT，key 已複製到 Windows 剪貼簿（沒有印出來）"
