#!/usr/bin/env bash
# 收掉 Funnel 模式：關 Funnel → 停 server → 換掉 key（給出去的那把就作廢）。重跑也安全。
set -euo pipefail

PORT=8000
FUNNEL_PORT=8443

# PowerShell 查無結果也會回 exit 1，成敗一律看最後的驗證
pwsh() { powershell.exe -NoProfile -Command "$1" </dev/null | tr -d '\r' || true; }

command -v powershell.exe >/dev/null || { echo "找不到 powershell.exe：要在桌機 WSL 跑" >&2; exit 1; }

pwsh "tailscale funnel --https=$FUNNEL_PORT off" >/dev/null 2>&1 || true
pwsh "Get-NetTCPConnection -LocalPort $PORT -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id \$_.OwningProcess -Force }"
pwsh "& \"\$env:USERPROFILE\.local\bin\windows-mcp.exe\" auth --transport streamable-http --host 127.0.0.1 --port $PORT --force *> \$null"

left=$(pwsh "(Get-NetTCPConnection -LocalPort $PORT -State Listen -ErrorAction SilentlyContinue | Measure-Object).Count")
funnel=$(pwsh "tailscale funnel status" | grep -c ":$FUNNEL_PORT" || true)
echo "還在聽 $PORT 的程式：$left，Funnel :$FUNNEL_PORT 剩 $funnel 條（都要 0）"
[ "$left" = 0 ] && [ "$funnel" = 0 ]
echo "已收掉，key 已換新"
