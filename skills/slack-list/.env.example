# 複製到 ~/.config/slack-list/.env 再填。這個位置不在任何 repo 裡，token 不會被 commit。
#   mkdir -p ~/.config/slack-list && cp .env.example ~/.config/slack-list/.env && chmod 600 ~/.config/slack-list/.env
# 環境變數裡已經有的值優先（container 用 env_file 注入時不需要這個檔）。

# Slack app 的 Bot User OAuth Token
# api.slack.com/apps → 你的 app → OAuth & Permissions → 最上面
SLACK_BOT_TOKEN=xoxb-

# 要讀的那張 List 的 ID
# 在 Slack 打開那張表，從網址列取（例如 Bug/需求總表）
SLACK_LIST_ID=

# 你自己的 Slack 成員 ID（U 開頭），給 `slack-list mine` 過濾用
# Slack 點自己頭像 → 個人檔案 → 右上「⋮」→ 複製成員 ID
# 上面那顆 xoxb- token 問不出這個，它只知道 bot 自己是誰
SLACK_MY_USER_ID=

# 組 List 單列深連結用。打開那張表，網址長這樣：
#   https://<workspace>.slack.com/lists/<TEAM_ID>/<LIST_ID>
SLACK_WORKSPACE_URL=https://example.slack.com
SLACK_TEAM_ID=

# 前端分支預覽的網域（branch 名轉成 slug 之後接在前面）。script 不用，給 agent 從 `slack-list env` 查
PREVIEW_DOMAIN=example.pages.dev

# agent：可用 gh 查重並建立 issue；manual：只把草稿交到 Slack，由人發布
WORK_HELPER_ISSUE_MODE=agent
