#!/usr/bin/env zsh
# 從 Codex 設定取出目前 provider 的 Image API 憑證，交給系統 image_gen.py。
# 這支腳本刻意不啟用 shell trace，避免暴露 OPENAI_API_KEY。

set -euo pipefail

usage() {
	cat >&2 <<'USAGE'
用法:
  imagegen-fallback generate [image_gen.py 參數...]
  imagegen-fallback generate-batch [image_gen.py 參數...]
  imagegen-fallback edit [image_gen.py 參數...]

將參數原封不動傳給 Codex 內建的 image_gen.py。請在工作區執行，並把輸出放在
output/imagegen/，例如加上 --out output/imagegen/result.png。

首次安裝（本 wrapper 不會自動安裝套件，也不會使用 sudo）：
  mkdir -p "$HOME/.local/share/imagegen-fallback"
  python3 -m venv "$HOME/.local/share/imagegen-fallback/venv"
  "$HOME/.local/share/imagegen-fallback/venv/bin/python" -m pip install openai
USAGE
}

if [[ -z "${HOME:-}" ]]; then
	print -u2 'imagegen-fallback: 找不到 HOME。'
	exit 1
fi

if (( $# == 0 )); then
	usage
	exit 2
fi

if [[ "$1" == '-h' || "$1" == '--help' ]]; then
	usage >&2
	exit 0
fi

CONFIG_FILE="$HOME/.codex/config.toml"
IMAGE_GEN="$HOME/.codex/skills/.system/imagegen/scripts/image_gen.py"
IMAGEGEN_PYTHON="$HOME/.local/share/imagegen-fallback/venv/bin/python"

if [[ ! -x "$IMAGEGEN_PYTHON" ]]; then
	print -u2 "imagegen-fallback: 找不到可執行的 venv Python $IMAGEGEN_PYTHON。"
	print -u2 '請先手動建立 venv 並安裝 openai（不會自動安裝，也不要使用 sudo）：'
	print -u2 '  mkdir -p "$HOME/.local/share/imagegen-fallback"'
	print -u2 '  python3 -m venv "$HOME/.local/share/imagegen-fallback/venv"'
	print -u2 '  "$HOME/.local/share/imagegen-fallback/venv/bin/python" -m pip install openai'
	exit 1
fi

if [[ ! -e "$CONFIG_FILE" ]]; then
	print -u2 "imagegen-fallback: 找不到設定檔 $CONFIG_FILE。"
	exit 1
fi
if [[ ! -f "$CONFIG_FILE" || ! -r "$CONFIG_FILE" ]]; then
	print -u2 "imagegen-fallback: 設定檔無法讀取 $CONFIG_FILE。"
	exit 1
fi

if [[ ! -e "$IMAGE_GEN" ]]; then
	print -u2 "imagegen-fallback: 找不到 image_gen.py $IMAGE_GEN。"
	exit 1
fi
if [[ ! -f "$IMAGE_GEN" || ! -r "$IMAGE_GEN" ]]; then
	print -u2 "imagegen-fallback: image_gen.py 無法讀取 $IMAGE_GEN。"
	exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
	print -u2 'imagegen-fallback: 找不到 python3；需要 Python 3.11 以上（含標準 tomllib）。'
	exit 1
fi

# Python 只把兩個欄位傳回這個 shell 的 command substitution；不把 token 印到終端機。
typeset config_output
if ! config_output="$(python3 - "$CONFIG_FILE" <<'PY'
import sys

try:
    import tomllib
except ModuleNotFoundError:
    print("imagegen-fallback: Python 沒有標準 tomllib；需要 Python 3.11 以上。", file=sys.stderr)
    raise SystemExit(1)


def fail(message: str) -> None:
    print(f"imagegen-fallback: {message}", file=sys.stderr)
    raise SystemExit(1)


config_path = sys.argv[1]
try:
    with open(config_path, "rb") as config_file:
        config = tomllib.load(config_file)
except FileNotFoundError:
    fail(f"找不到設定檔 {config_path}。")
except PermissionError:
    fail(f"設定檔無法讀取 {config_path}。")
except OSError:
    fail(f"設定檔無法讀取 {config_path}。")
except tomllib.TOMLDecodeError:
    fail(f"設定檔不是有效 TOML：{config_path}。")

model_provider = config.get("model_provider")
if not isinstance(model_provider, str) or not model_provider:
    fail("設定檔缺少必要欄位 model_provider。")

providers = config.get("model_providers")
if not isinstance(providers, dict):
    fail("設定檔缺少必要區段 model_providers。")

provider = providers.get(model_provider)
if not isinstance(provider, dict):
    fail(f"找不到 model_provider '{model_provider}' 的設定。")

base_url = provider.get("base_url")
if not isinstance(base_url, str) or not base_url:
    fail(f"provider '{model_provider}' 缺少必要欄位 base_url。")

token = provider.get("experimental_bearer_token")
if not isinstance(token, str) or not token:
    fail(f"provider '{model_provider}' 缺少必要欄位 experimental_bearer_token。")

print(base_url)
print(token)
PY
)"; then
	exit 1
fi

typeset -a config_values
config_values=("${(@f)config_output}")
if (( ${#config_values[@]} != 2 )); then
	print -u2 'imagegen-fallback: 讀取設定檔時沒有取得必要欄位。'
	exit 1
fi

OPENAI_BASE_URL="${config_values[1]}"
OPENAI_API_KEY="${config_values[2]}"
export OPENAI_BASE_URL OPENAI_API_KEY

exec "$IMAGEGEN_PYTHON" "$IMAGE_GEN" "$@"
