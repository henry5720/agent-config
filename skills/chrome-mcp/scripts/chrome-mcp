#!/usr/bin/env bash
# 啟動 Windows 側的 Chrome 並開 remote debugging port,給 chrome-devtools MCP 連。
# WSL 這邊不裝 Linux Chrome —— 設定本來就是連 Windows 那台,在 WSL 另開一個是白費工。
# 怎麼用見同一個 skill 的 SKILL.md；背景與排錯見 dotfiles 的 docs/chrome-devtools-mcp.md。

set -euo pipefail

PORT=9222
PROFILE_NAME=ChromeDevToolsMCP
version_response=$(mktemp)
trap 'rm -f "$version_response"' EXIT

check_devtools_endpoint() {
  local http_code curl_status

  : >"$version_response"
  http_code=$(curl -sS --max-time 2 -o "$version_response" -w '%{http_code}' \
    "http://127.0.0.1:$PORT/json/version") || curl_status=$?
  curl_status=${curl_status:-0}

  # curl 失敗且沒有收到 HTTP 回應，代表 port 尚未在這裡提供服務。
  if [ "$curl_status" -ne 0 ] && [ "${http_code:-000}" = 000 ]; then
    return 2
  fi

  # 有任何 HTTP 回應都算 port 已被占用；不是 Chrome DevTools endpoint 就立即失敗。
  if [ "${http_code:-000}" != 200 ] || ! jq -e '
    type == "object" and
    (.Browser | type == "string" and length > 0) and
    (.webSocketDebuggerUrl | type == "string" and startswith("ws://"))
  ' "$version_response" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

# 開著就是在用，關掉就整組收掉：轉發跑在前景，Ctrl+C / 關終端機時 trap 收轉發、
# 關掉 MCP profile 的 Chrome。以前用 ssh -f 丟背景，沒人收，換台或重開機後 EC2 的 9222
# 還被舊連線佔著。trap 跑不到的情況:斷電、重開機(EC2 那頭靠 sshd 的 ClientAliveInterval
# 清死連線),以及 herdr 關 pane(HUP 之後整棵 process 馬上被砍,連 setsid 出去的都活不了;
# 轉發會斷,Chrome 會留著)。留著的 Chrome 下次跑會沿用，結束時一起關。

close_chrome() {
  # 先 CloseMainWindow 讓它正常關(下次不會跳「還原分頁」),5 秒沒關再強制。
  powershell.exe -NoProfile -NonInteractive -Command '
    $p = Get-CimInstance Win32_Process -Filter "Name='\''chrome.exe'\''" |
      Where-Object { $_.CommandLine -match "ChromeDevToolsMCP" -and $_.CommandLine -notmatch "--type=" }
    foreach ($x in $p) { (Get-Process -Id $x.ProcessId -ErrorAction SilentlyContinue).CloseMainWindow() | Out-Null }
    Start-Sleep 5
    foreach ($x in $p) { Stop-Process -Id $x.ProcessId -Force -ErrorAction SilentlyContinue }
  ' </dev/null >/dev/null 2>&1 || true
}

cleanup() {
  trap - EXIT
  echo "關掉 MCP Chrome..." 2>/dev/null || true
  close_chrome
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

# 只有這條連線帶 RemoteForward(見 ~/.ssh/config 的 Host company-ec2-chrome):EC2 的
# 9222 只有一個位子，每條 ssh 都帶的話先連的搶到、其他默默失敗。
EC2_TUNNEL_HOST=company-ec2-chrome
hold() {
  # ssh config 沒有這個 Host(只在本機用的機器)就只守著 Chrome。
  if ! ssh -G "$EC2_TUNNEL_HOST" 2>/dev/null | grep -qi '^remoteforward '; then
    echo "開著中，按 Ctrl+C 關掉 Chrome。"
    while sleep 3600; do :; done
  fi

  echo "轉發 9222 到 company-ec2 中，那邊的 MCP 會用這台的 Chrome。按 Ctrl+C 全部關掉。"
  local status=0
  ssh -N -o BatchMode=yes -o ConnectTimeout=10 "$EC2_TUNNEL_HOST" || status=$?
  # 被 Ctrl+C 打斷時 trap 已經在處理，走不到這裡;走到這裡是 ssh 自己斷了。
  echo "轉發斷了(ssh exit $status)。" >&2
  echo "一連上就斷、印了 remote port forwarding failed:company-ec2 的 9222 被別台占著," >&2
  echo "去那台把 chrome-mcp 關掉(Ctrl+C)再重跑;那台已經關機的話等 EC2 清掉死連線(約 90 秒)。" >&2
  exit 1
}

# 1. 已經在跑就不再開 —— 這一步不是禮貌，是必要的:Chrome 已有實例時，再下一次帶參數的
#    啟動會被轉交給既有實例、新參數整組被忽略、而且不報錯。少了這個檢查，你會看到
#    「指令跑完、沒有錯誤、MCP 還是連不上」,那是最難查的一種。
if check_devtools_endpoint; then
  echo "Chrome 已經在 127.0.0.1:$PORT 上跑了，沿用它。"
  hold
elif [ "$?" -eq 1 ]; then
  echo "127.0.0.1:$PORT 已有服務，但不是有效的 Chrome DevTools endpoint。" >&2
  exit 1
fi

# 2. 先確認 WSL 能呼叫 Windows 的 cmd.exe 和 powershell.exe。
for windows_command in cmd.exe powershell.exe; do
  if ! command -v "$windows_command" >/dev/null 2>&1; then
    echo "找不到 $windows_command,確認 WSL interop 有開。" >&2
    exit 1
  fi
done
if ! (cd /mnt/c && cmd.exe /c exit 0) >/dev/null 2>&1 || \
   ! powershell.exe -NoProfile -NonInteractive -Command 'exit 0' >/dev/null 2>&1; then
  echo "WSL interop 驗證失敗,cmd.exe 或 powershell.exe 無法執行。" >&2
  exit 1
fi

# 3. 找 chrome.exe。64 位元裝在 Program Files,舊的 32 位元在 Program Files (x86)。
chrome=""
for candidate in \
  "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe" \
  "/mnt/c/Program Files (x86)/Google/Chrome/Application/chrome.exe"
do
  [ -x "$candidate" ] && { chrome="$candidate"; break; }
done
if [ -z "$chrome" ]; then
  echo "找不到 chrome.exe。裝在別的位置的話改這支 script 的候選清單。" >&2
  exit 1
fi

# 4. 問 Windows 自己的 %LOCALAPPDATA%,不要寫死 C:\Users\henry ——
#    --user-data-dir 要的是 Windows 路徑格式,而使用者名稱換台機器就不一樣。
#    cd /mnt/c 是為了避開 cmd.exe 對 UNC 路徑的警告。
localappdata=$(cd /mnt/c && cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')
if [ -z "$localappdata" ]; then
  echo "問不到 Windows 的 %LOCALAPPDATA%,確認 WSL interop 有開(cmd.exe 叫得動)。" >&2
  exit 1
fi
profile="${localappdata}\\${PROFILE_NAME}"
if ! powershell.exe -NoProfile -NonInteractive -Command \
  '$p = Join-Path $env:LOCALAPPDATA "ChromeDevToolsMCP"; if (-not (Test-Path -LiteralPath $p)) { New-Item -ItemType Directory -Path $p -Force | Out-Null }; if (-not (Test-Path -LiteralPath $p -PathType Container)) { exit 1 }; exit 0' \
  >/dev/null 2>&1; then
  echo "無法驗證或建立 Chrome 專用 profile: ${profile}" >&2
  exit 1
fi

# 5. 啟動。用獨立 profile 而不是你平常那個:平常那個開著的時候 Chrome 不會理
#    --remote-debugging-port,而且讓 agent 碰你日常瀏覽的 session 也不是好主意。
echo "啟動 Chrome(profile: ${profile})..."
nohup "$chrome" \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port="$PORT" \
  --user-data-dir="$profile" \
  >/dev/null 2>&1 &
disown

# 6. 等 endpoint 真的起來再回報。不等的話這支 script 會在 Chrome 還沒開完時就說成功。
for _ in $(seq 1 15); do
  if check_devtools_endpoint; then
    echo "好了,127.0.0.1:$PORT 通了。"
    hold
  elif [ "$?" -eq 1 ]; then
    echo "127.0.0.1:$PORT 已有服務,但不是有效的 Chrome DevTools endpoint。" >&2
    exit 1
  fi
  sleep 1
done

echo "等了 15 秒 127.0.0.1:$PORT 還是不通。" >&2
echo "檢查 .wslconfig 是不是 networkingMode=mirrored —— 不是的話 WSL 連不到 Windows 的 localhost。" >&2
exit 1
