#!/usr/bin/env python3
"""用 Tailscale Funnel 把本機 port 開到 tailnet 外：開、從公網驗證、收。

  expose-port-funnel open --port 8000 --https 8443 --path /mcp \\
      --expect-without 401 --expect-with 200 --auth-header-cmd '<印出驗證 header 的指令>' \\
      -- <兩次驗證都帶的 curl 參數>
  expose-port-funnel verify --url https://<機器>.<tailnet>.ts.net:8443 --path /mcp \\
      --expect-without 401 --expect-with 200 --auth-header-cmd '…' -- <curl 參數>
  expose-port-funnel check-closed --url https://<機器>.<tailnet>.ts.net:8443
  expose-port-funnel close --https 8443

open 照 remote-access 的共通規則前景跑：Funnel 不加 --bg，驗證過了印出公開網址就停著，
收到 Ctrl+C／SIGTERM 才撤掉 Funnel。驗證沒過也會撤掉再結束。
verify、check-closed 給 Funnel 開在別台（使用者貼指令開的）時用：只從這邊驗開著、驗收掉，不開也不收。
close 給上一輪沒收乾淨時用，重跑也安全。

收的完成條件是兩項都成立，不看 `tailscale funnel status`（前景 Funnel 不會列在裡面，
印 `No serve config` 時公網照樣通，2026-11-05 henry-laptop 實測）：
  1. 這個對外 port 的 `tailscale funnel` 行程剩 0 個。TAILSCALE 叫的是 Windows 的 tailscale
     （WSL 經 powershell.exe）時，停掉這邊的 powershell.exe 不會停掉 Windows 的 tailscale.exe，
     腳本會從 PowerShell 停掉它
  2. 從公網打公開網址連不上（000，或公開 DNS 查不到）

驗證的 header 由 --auth-header-cmd 印出，寫進只有自己讀得到的暫存檔再用 `curl -H @檔案` 帶，
不會出現在 curl 的參數裡（ps 看得到參數）。驗證、輸出這些跟 quick tunnel 共用的在 expose_port_common.py。

環境變數：
  TAILSCALE                    叫 tailscale 的指令（照 shell 斷字）。沒設時用 tailscale，
                               這個使用者不是 tailscale operator 就加 sudo
  EXPOSE_PORT_PROBE_INTERVAL   等 Funnel 生效、收掉時每次重試間隔秒數，預設 3（測試設 0）
"""
import argparse
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

# 共用模組放在同目錄；skill 資料夾會 sync 到各 client，不留 __pycache__
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from expose_port_common import (  # noqa: E402
    add_verify_args, cmd_check_closed, public_closed, public_state, run, say, split_curl_args, verify,
    wait_public_ip, windows_procs, windows_shell,
)

FUNNEL_PORTS = (443, 8443, 10000)
FUNNEL_URL_RE = re.compile(r"https://([a-z0-9-]+\.)+ts\.net(:(443|8443|10000))?")


def die(msg):
    say(msg)
    sys.exit(1)


def tailscale_cmd():
    if os.environ.get("TAILSCALE"):
        return shlex.split(os.environ["TAILSCALE"])
    if os.geteuid() == 0:
        return ["tailscale"]
    # 改 serve／funnel 設定要 sudo，除非這個使用者是 operator（tailscale set --operator=$USER）
    prefs = run(["tailscale", "debug", "prefs"])
    try:
        operator = json.loads(prefs.stdout).get("OperatorUser", "")
    except ValueError:
        operator = ""
    return ["tailscale"] if operator == os.environ.get("USER") else ["sudo", "tailscale"]


def serve_entries(ts):
    """`tailscale funnel status` 列出的每個對外 port：[(port, 是不是 Funnel)]。443 的網址不帶 port。

    只列得到 --bg 留下的 serve config；前景 Funnel 不一定在裡面，所以收的時候不靠它判斷收乾淨了沒。
    """
    entries = []
    status = run(ts + ["funnel", "status"]).stdout.replace("\r", "")
    for line in status.splitlines():
        if not line.startswith("https://"):
            continue
        hostport = line.split()[0][len("https://"):].split("/")[0]
        port = int(hostport.rsplit(":", 1)[1]) if ":" in hostport else 443
        entries.append((port, "Funnel on" in line))
    return entries


def funnel_procs(ts, https, stop=False):
    """開這個對外 port 的 `tailscale funnel` 行程數；stop=True 先停掉再數。數不出來回 -1。"""
    shell = windows_shell(ts)
    if shell:
        return windows_procs(shell, "tailscale.exe", ["funnel", f"--https={https}( |$)"], stop)
    pattern = rf"tailscale(\.exe)? funnel --https={https}( |$)"
    if stop and run(["pgrep", "-f", pattern]).stdout.split():
        run((["sudo"] if ts[0] == "sudo" else []) + ["pkill", "-f", pattern])
        time.sleep(0.5)
    return len(run(["pgrep", "-f", pattern]).stdout.split())


def public_url(host, https):
    return f"https://{host}:{https}/"


def close_funnel(ts, https, host, child=None):
    """撤掉 Funnel，回傳收乾淨了沒：停前景那支 → off 掉 --bg 留下的設定 → 停掉還在的 funnel 行程 → 從公網確認連不上。"""
    if child is not None and child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=10)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
    if any(port == https for port, _ in serve_entries(ts)):
        run(ts + ["funnel", f"--https={https}", "off"])
    left = funnel_procs(ts, https, stop=True)
    say(f"tailscale funnel :{https} 的行程剩 {left} 個（要 0）" if left >= 0
        else f"數不出 tailscale funnel :{https} 的行程（要 0）")
    if not host:
        say("查不到這台的 ts.net 名稱，沒辦法從公網確認")
        closed = False
    else:
        closed = public_closed(public_url(host, https))
    ok = left == 0 and closed
    say(f"Funnel :{https} 已收乾淨" if ok else f"Funnel :{https} 還沒收乾淨：照 expose-port 的 reference.md〈收掉後還在〉處理")
    return ok


def dns_name(ts):
    out = run(ts + ["status", "--json"]).stdout
    try:
        return json.loads(out)["Self"]["DNSName"].rstrip(".")
    except (ValueError, KeyError, TypeError):
        return ""


def cmd_open(args):
    ts = tailscale_cmd()
    host = dns_name(ts)
    if not host:
        die("tailscale 沒登入，或叫不到 tailscale（tailscale status 看看）")
    taken = any(port == args.https for port, _ in serve_entries(ts)) or funnel_procs(ts, args.https) != 0
    if not taken:
        taken = not public_state(public_url(host, args.https))[0]
    if taken:
        die(f"Funnel／serve :{args.https} 已經開著（別的程式在用，或上一輪沒收）。換一個 port，或確認沒人用後跑 close --https {args.https}")

    say(f"開 Funnel :{args.https} → 127.0.0.1:{args.port}（前景，收到 Ctrl+C／SIGTERM 就撤）…")
    child = subprocess.Popen(
        ts + ["funnel", f"--https={args.https}", f"http://127.0.0.1:{args.port}"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )

    def finish(code):
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(sig, signal.SIG_IGN)
        ok = close_funnel(ts, args.https, host, child)
        sys.exit(code if ok else 1)

    # handler 只丟例外，收尾在主流程做：在 handler 裡 wait 子行程會跟被打斷的 child.wait() 搶鎖卡死
    def stop(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    try:
        ip = wait_public_ip(host)
        if not ip:
            say(f"公開 DNS 一直查不到 {host} 的 IP")
            finish(1)
        if not verify(args, f"https://{host}:{args.https}", ip):
            say("驗證沒過，Funnel 已撤掉。看 expose-port 的 reference.md")
            finish(1)
        say(f"公開網址：https://{host}:{args.https}{args.path}")
        say("停著直到 Ctrl+C／SIGTERM，收到就撤掉 Funnel")
        child.wait()
        say("Funnel 自己結束了")
        finish(1)
    except KeyboardInterrupt:
        finish(0)


def cmd_close(args):
    ts = tailscale_cmd()
    sys.exit(0 if close_funnel(ts, args.https, dns_name(ts)) else 1)


def cmd_verify(args):
    url = args.url.rstrip("/")
    if not FUNNEL_URL_RE.fullmatch(url):
        say("--url 要是 https://<機器>.<tailnet>.ts.net[:443|8443|10000]")
        sys.exit(1)
    host = url.split("//", 1)[1].split(":")[0]
    ip = wait_public_ip(host)
    if not ip:
        say(f"公開 DNS 一直查不到 {host} 的 IP")
        sys.exit(1)
    ok = verify(args, url, ip)
    if ok:
        say(f"公開網址：{url}{args.path}")
    sys.exit(0 if ok else 1)


def funnel_port(value):
    port = int(value)
    if port not in FUNNEL_PORTS:
        raise argparse.ArgumentTypeError("Funnel 只能用 443、8443、10000")
    return port


def main(argv):
    argv, curl_args = split_curl_args(argv)
    parser = argparse.ArgumentParser(prog="expose-port-funnel")
    sub = parser.add_subparsers(dest="cmd", required=True)
    op = sub.add_parser("open")
    op.add_argument("--port", type=int, required=True, help="本機 app 聽的 port")
    op.add_argument("--https", type=funnel_port, default=8443, help="對外 port：443、8443、10000")
    add_verify_args(op)
    ve = sub.add_parser("verify", help="Funnel 開在別台時，從這邊驗那個網址")
    ve.add_argument("--url", required=True, help="https://<機器>.<tailnet>.ts.net:<對外 port>")
    add_verify_args(ve)
    cc = sub.add_parser("check-closed", help="Funnel 開在別台、收掉後，從這邊確認公網連不上")
    cc.add_argument("--url", required=True, help="https://<機器>.<tailnet>.ts.net:<對外 port>")
    cl = sub.add_parser("close")
    cl.add_argument("--https", type=funnel_port, default=8443)
    args = parser.parse_args(argv)
    args.curl_args = curl_args
    sys.stdout.reconfigure(line_buffering=True)
    {"open": cmd_open, "verify": cmd_verify, "check-closed": cmd_check_closed, "close": cmd_close}[args.cmd](args)


if __name__ == "__main__":
    main(sys.argv[1:])
