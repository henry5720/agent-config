#!/usr/bin/env python3
"""連到別台的服務，或把本機 port 開到 tailnet 外。

  remote-access up <服務> <host> …                                 在那台起服務、開 serve、驗證
  remote-access down <服務> <host>                                 收掉那台的服務和 serve
  remote-access ps [<服務> [<host>]]                               列出在跑的服務、接哪台、驗證過沒
  remote-access key <init|rotate>                                  agent 這台的固定 key：產生、換新並同步
  remote-access funnel <open|verify|check-closed|close> …        Tailscale Funnel
  remote-access quick-tunnel <open|verify|check-closed|close> …  Cloudflare quick tunnel

服務定義在 skill 的 services.yaml，host 是 ssh config 的 Host。
各子命令的參數看 `remote-access <子命令> --help`。
同一台、tailnet 內不用這支，做法在 remote-access skill。
"""
import importlib
import sys
from pathlib import Path

# 子命令的模組放在同目錄；skill 資料夾會 sync 到各 client，不留 __pycache__
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

SUBCOMMANDS = {
    "funnel": "remote_access_funnel", "quick-tunnel": "remote_access_quick_tunnel",
    "up": "remote_access_service", "down": "remote_access_service", "ps": "remote_access_service",
    "key": "remote_access_key",
}


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        sys.exit(0)
    if not argv or argv[0] not in SUBCOMMANDS:
        sys.stderr.write(__doc__.strip() + "\n")
        sys.exit(2)
    importlib.import_module(SUBCOMMANDS[argv[0]]).main(argv[1:], prog=f"remote-access {argv[0]}")


if __name__ == "__main__":
    main(sys.argv[1:])
