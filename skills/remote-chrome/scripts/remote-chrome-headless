#!/usr/bin/env bash
# 在這台主機自己開 headless Chrome 佔 127.0.0.1:9222,給 chrome-devtools MCP 查原因用。
# MCP 的設定不用改 —— mcp.yaml 寫死連 9222。
# Chrome 由 dotfiles chezmoi 選裝工具的 headless-chrome 裝(官方 .deb + 中文/emoji 字型)。
# 怎麼用見同一個 skill 的 SKILL.md;背景與排錯見同一個資料夾的 reference.md。

set -euo pipefail

# 判斷 Chrome 起來沒要靠 curl 和 jq。少了它們判斷永遠為假，會等滿 15 秒才說「還是不通」，
# 看起來像 Chrome 的問題 —— 所以一開始就檢查。兩個都是 dotfiles 的基底套件。
for required_command in curl jq; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "找不到 $required_command。它是 dotfiles 的基底套件，chezmoi apply 會裝。" >&2
    exit 1
  fi
done

PORT=9222
# 登入狀態放這裡，關掉再開還在。是狀態不是快取，所以不放 ~/.cache。
# 目錄名沿用 skill 改名前的 chrome-mcp-profile:改了會換成新的空 profile,EC2 上登入過的網站要重登。
PROFILE="${XDG_STATE_HOME:-$HOME/.local/state}/chrome-mcp-profile"
LOG="$PROFILE.log"

endpoint_browser() {
  curl -s --max-time 2 "http://127.0.0.1:$PORT/json/version" | jq -er '.Browser // empty' 2>/dev/null
}

# 誰在聽 9222:印 ss 那一行(看得到 process 名和 pid);ss 沒有或看不到就提示自己查。
port_owner() {
  ss -Hltnp "sport = :$PORT" 2>/dev/null | grep . || echo "(看不到是誰,用 ss -ltnp 查)"
}

# 1. 9222 已經有 Chrome 就不開:多半是上一次的 remote-chrome-headless 還開著,MCP 現在就能用。
#    9222 有別的東西(不是 Chrome)就失敗,說是誰佔著。
if browser=$(endpoint_browser); then
  echo "127.0.0.1:$PORT 已經有 Chrome($browser),不用開。佔著的是:"
  port_owner
  exit 0
fi
if curl -s --max-time 2 -o /dev/null "http://127.0.0.1:$PORT/"; then
  echo "127.0.0.1:$PORT 已有服務，但不是 Chrome DevTools endpoint。佔著的是:" >&2
  port_owner >&2
  exit 1
fi

if ! command -v google-chrome >/dev/null 2>&1; then
  echo "找不到 google-chrome。chezmoi edit-config 把 headless-chrome 加進 tools，再 chezmoi apply。" >&2
  exit 1
fi

# 2. 啟動。不加 --no-sandbox:官方 .deb 帶 /etc/apparmor.d/chrome 和 setuid 的 chrome-sandbox,
#    Ubuntu 24.04 限制 unprivileged userns 也開得起來。stderr 的 dbus 錯誤是沒桌面環境的正常雜訊，丟進 log。
#    setpriv --pdeathsig:這支 script 不管怎麼結束(Ctrl+C、TERM、關 herdr pane 時整棵被砍、連 SIGKILL),
#    kernel 都會對 Chrome 送 TERM,不留著佔 9222(下一個要用 9222 的人會開不起來)。
#    trap 裡自己收做不到這點:被 SIGKILL 時 trap 不會跑。
mkdir -p "$PROFILE"
setpriv --pdeathsig TERM google-chrome \
  --headless \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port="$PORT" \
  --user-data-dir="$PROFILE" \
  --no-first-run --no-default-browser-check \
  --window-size=1280,800 \
  >"$LOG" 2>&1 &
chrome_pid=$!

# 開著就是在用:Ctrl+C / 關終端機就結束，Chrome 跟著收掉(見上面的 --pdeathsig)。
trap 'echo "關掉 headless Chrome..." 2>/dev/null || true' EXIT
trap 'exit 130' INT TERM HUP

# 3. 等 endpoint 真的起來再回報。
for _ in $(seq 1 15); do
  if browser=$(endpoint_browser); then
    echo "好了,127.0.0.1:$PORT 是 $browser(profile: $PROFILE)。按 Ctrl+C 關掉。"
    wait "$chrome_pid" || true
    echo "Chrome 自己結束了，看 $LOG。" >&2
    exit 1
  fi
  [ -e "/proc/$chrome_pid" ] || { echo "Chrome 啟動失敗，看 $LOG。" >&2; exit 1; }
  sleep 1
done

echo "等了 15 秒 127.0.0.1:$PORT 還是不通，看 $LOG。" >&2
exit 1
